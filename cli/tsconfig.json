  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../airglow-apps/node_modules/@types"]
  },
  "include": ["src/**/*", "lib/**/*"]
