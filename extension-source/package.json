{
  "name": "airglow-extension",
  "description": "Airglow Chrome extension — dynamic tool injection platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "test": "node --test tests/*.test.mjs",
    "export": "bash scripts/export-extension.sh",
    "smoke:sidepanel-mvp": "node scripts/sidepanel-mvp-smoke.mjs",
    "zip": "bash scripts/zip-for-store.sh",
    "chrome": "node ../airglow-apps/scripts/chrome.mjs .output/chrome-mv3-dev",
    "chrome:fresh": "node ../airglow-apps/scripts/chrome.mjs .output/chrome-mv3-dev --fresh"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/chrome": "^0.1.36",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "lucide-react": "^0.460.0",
    "posthog-js-lite": "^4.6.32"
  }
}
