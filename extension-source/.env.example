# Extension build-time env vars (WXT/Vite inlines anything prefixed WXT_).
# All optional — defaults in code are fine for prod builds.

# Point exported builds at a local Airglow Cloud while testing side panel private
# app save. Empty/absent -> https://mvp-api.airglow.dev.
# WXT_CLOUD_APP_SOURCE_URL=http://127.0.0.1:3002

# Override PostHog project (e.g. point a dev build at a separate test project).
# Empty/absent → falls back to the public default key embedded in lib/posthog.ts.
# WXT_POSTHOG_KEY=phc_…
# WXT_POSTHOG_HOST=https://us.i.posthog.com
