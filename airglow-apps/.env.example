# Workspace .env — loaded into the dev server on every `pnpm airglow dev`.
# Per-app `<app-id>/.env` overrides values here.
#
# Naming rule:
#   CLIENT_<NAME>   →  client-side. Preloaded into chrome.storage.local and
#                      readable from browser/userscript/UI code via
#                      airglow.storage.get('<NAME>') (no CLIENT_ prefix).
#                      Declare in manifest.json's `secrets`.
#
#   <NAME>          →  server-side. Readable only from server/*.ts via
#                      process.env.<NAME>. Never reaches the browser.
#                      Declare in manifest.json's `server_env`.

# Bundled apps in this workspace expect:
# CLIENT_ANTHROPIC_API_KEY=sk-ant-...   # askme-anything, linkedin-researcher, page-navigator
# COMPOSIO_API_KEY=ak_...               # gmail-calendar
