{
  "id": "askme-anything",
  "name": "Ask Me Anything",
  "version": "0.1.0",
  "description": "Highlight text, press Cmd+J, get AI-powered explanations with web search",
  "tags": ["ai", "search", "explain", "translate"],
  "userscripts": [
    { "file": "userscripts/global.ts", "matches": ["<all_urls>"], "runAt": "document_idle" }
  ],
  "secrets": {
    "ANTHROPIC_API_KEY": { "label": "Anthropic API Key" }
  }
}
