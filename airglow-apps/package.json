{
  "name": "airglow-apps",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for Airglow apps. Each subdirectory with a manifest.json is an app.",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "airglow": "node ../cli/bin/airglow.js",
    "dev": "node ../cli/bin/airglow.js dev",
    "chrome": "node scripts/chrome.mjs",
    "composio": "tsx scripts/composio-tools.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/cli": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@tailwindcss/oxide"]
  }
}
