{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["airglow.d.ts", "*/ui/**/*", "*/server/**/*", "*/userscripts/**/*", "*/startup.*"],
  "exclude": ["*/node_modules"]
}
