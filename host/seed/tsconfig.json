{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@shared/*": ["shared/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "airglow.d.ts",
    "apps/*/ui/**/*",
    "apps/*/server/**/*",
    "apps/*/userscripts/**/*",
    "apps/*/startup.*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "apps/*/node_modules"]
}
