{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@shared/*": ["shared/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    // Treat every app file as its own module scope. Userscripts carry no
    // import/export, so without this tsc lumps them into one global scope and
    // reports phantom cross-file/cross-app collisions (init, observer, …) that
    // can never happen at runtime (each userscript runs in an isolated world).
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "airglow.d.ts",
    "apps/*/ui/**/*",
    "apps/*/server/**/*",
    "apps/*/userscripts/**/*",
    "apps/*/startup.*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "apps/*/node_modules"]
}
